# Copiar a .env (o a /etc/brigadas.env en el servidor) y completar.
# El archivo real NUNCA va al repositorio: contiene tokens y la clave de la base.
# En producción: root:root, permisos 0600.

# Un token por brigada, separados por coma. Generarlos con:
#   openssl rand -hex 24
BRIGADA_TOKENS=cambiar-esto,y-esto,y-esto-tambien

# Base de datos. La contraseña debe coincidir con POSTGRES_PASSWORD de la compose.
BRIGADA_DSN=postgresql://brigadas:CAMBIAR@127.0.0.1:5433/brigadas

# AGPL §13: si despliega una versión modificada, apunte esto a SU repositorio.
# La obligación es entregar el código que realmente está corriendo.
BRIGADA_FUENTE=https://github.com/abenito32/brigadaestructural

# Dónde se guardan las fotos. La base solo almacena rutas, nunca base64.
BRIGADA_FOTOS=/var/lib/brigadas/fotos

# Solo para docker compose:
POSTGRES_PASSWORD=CAMBIAR
