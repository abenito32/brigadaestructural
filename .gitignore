# Secretos: tokens de brigada, contraseña de la base, DSN.
.env
*.env
!.env.example

# La compose real lleva la contraseña; se publica solo la de ejemplo.
docker-compose.yml

# Datos de campo: fotos de predios evaluados y respaldos. Nunca al repo.
fotos/
*.jpg
*.jpeg
evaluaciones.csv
evaluaciones.json

# Las presentaciones y sus exportaciones llevan el correo de contacto: se arman
# en local y se envían, no se versionan en un repositorio público. El patrón es
# amplio a propósito, para que una copia renombrada no vuelva a colarse.
docs/*.pptx
docs/*.pdf
!docs/manual-brigada.pdf
~$*
.~lock.*#

# Respaldos y temporales
*.bak
*.bak-*
__pycache__/
*.pyc
.DS_Store
venv/
.venv/
